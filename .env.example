# Required production alerting
TG_BOT_TOKEN=
TG_CHAT_ID=

# External persistent PIT store (required for calibrated production forecast history)
DATABASE_URL=

# Recommended native ETH on-chain data provider
DUNE_API_KEY=

# Existing optional data providers
FRED_API_KEY=
FINNHUB_API_KEY=
CRYPTOPANIC_API_KEY=
ETHERSCAN_API_KEY=

# Optional custom ETH-native provider adapters.
# If any URL below is configured it takes precedence over the native Dune collector
# for backward compatibility. See docs/DATA_SOURCES.md.
ETH_VALUATION_API_URL=
ETH_VALUATION_API_TOKEN=
ETH_FLOW_API_URL=
ETH_FLOW_API_TOKEN=
ETH_STRUCTURAL_API_URL=
ETH_STRUCTURAL_API_TOKEN=
